src/renderer.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/vk_overlay.dir/build.make CMakeFiles/vk_overlay.dir/src/renderer.cpp.s
.PHONY : src/renderer.cpp.s

