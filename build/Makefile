	$(MAKE) $(MAKESILENT) -f CMakeFiles/vk_overlay.dir/build.make CMakeFiles/vk_overlay.dir/src/renderer.cpp.i
.PHONY : src/renderer.cpp.i

src/renderer.s: src/renderer.cpp.s
.PHONY : src/renderer.s

